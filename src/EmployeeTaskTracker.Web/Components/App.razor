@* Prerendering is switched off deliberately. The session token lives in the
   browser's protected local storage, which is only reachable through JS
   interop once the circuit is live - prerendering would render a signed-out
   shell first and then flash the real page in. *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* All styling is global, in app.css. There are no .razor.css files, so no
       CSS-isolation bundle is generated and linking one would only produce a
       404 on every page load. Add the bundle link back if scoped styles are
       ever introduced. *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>

<body>
    <Routes @rendermode="RenderModeNoPrerender" />

    @* Shown by the Blazor runtime if the SignalR circuit drops. *@
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">&times;</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly InteractiveServerRenderMode RenderModeNoPrerender = new(prerender: false);
}
