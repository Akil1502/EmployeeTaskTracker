@* Flat tinted pill for a task status. *@

<span class="pill @CssClass">@TaskStatuses.ToDisplay(Status)</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = TaskStatuses.Pending;

    private string CssClass => Status switch
    {
        TaskStatuses.Completed => "pill-done",
        TaskStatuses.InProgress => "pill-progress",
        _ => "pill-neutral"
    };
}
