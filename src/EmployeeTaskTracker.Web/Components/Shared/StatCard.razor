@* One dashboard summary figure. The number leads; the label sits above it in
   small caps so the eye lands on the value first. *@

<div class="stat-card stat-@Variant">
    <div class="stat-head">
        <span class="stat-label">@Label</span>
        <span class="stat-dot" aria-hidden="true"></span>
    </div>
    <div class="stat-value">@Value</div>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <div class="stat-note">@Note</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int Value { get; set; }

    /// <summary>One of total, pending, done or high - drives the accent dot.</summary>
    [Parameter] public string Variant { get; set; } = "total";

    /// <summary>Optional supporting line under the number.</summary>
    [Parameter] public string? Note { get; set; }
}
