@* Colour-coded pill for a task priority. *@

<span class="badge rounded-pill @CssClass">@Priority</span>

@code {
    [Parameter, EditorRequired] public string Priority { get; set; } = TaskPriorities.Medium;

    private string CssClass => Priority switch
    {
        TaskPriorities.High => "text-bg-danger",
        TaskPriorities.Medium => "text-bg-warning",
        _ => "text-bg-light border"
    };
}
