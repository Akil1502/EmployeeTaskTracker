@* Flat tinted pill for a task priority. *@

<span class="pill @CssClass">@Priority</span>

@code {
    [Parameter, EditorRequired] public string Priority { get; set; } = TaskPriorities.Medium;

    private string CssClass => Priority switch
    {
        TaskPriorities.High => "pill-high",
        TaskPriorities.Medium => "pill-medium",
        _ => "pill-low"
    };
}
