@* Side navigation.

   The Views section deep-links into the task list using the same query-string
   filters the dashboard cards use. It costs no extra request - these are plain
   links - and it gives the panel a job beyond holding two menu items. *@

<nav class="app-sidebar @(IsExpanded ? "expanded" : null)">
    <div class="app-brand">
        <BrandMark Size="32" />
        <div>
            <div class="app-brand-title">Task Tracker</div>
            <div class="app-brand-sub">Employee System</div>
        </div>
    </div>

    <div class="app-nav-scroll">
        <ul class="app-nav">
            <li class="app-nav-section">Workspace</li>
            <li>
                <NavLink class="app-nav-link" href="dashboard" Match="NavLinkMatch.All"
                         @onclick="NotifyNavigated">
                    <span class="app-nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                            <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.4" stroke="currentColor" stroke-width="1.4" />
                            <rect x="9" y="1.5" width="5.5" height="5.5" rx="1.4" stroke="currentColor" stroke-width="1.4" />
                            <rect x="1.5" y="9" width="5.5" height="5.5" rx="1.4" stroke="currentColor" stroke-width="1.4" />
                            <rect x="9" y="9" width="5.5" height="5.5" rx="1.4" stroke="currentColor" stroke-width="1.4" />
                        </svg>
                    </span>
                    Dashboard
                </NavLink>
            </li>
            <li>
                <NavLink class="app-nav-link" href="tasks" Match="NavLinkMatch.All"
                         @onclick="NotifyNavigated">
                    <span class="app-nav-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                            <path d="M2 4.4l1.6 1.6L6.8 2.8" stroke="currentColor" stroke-width="1.4"
                                  stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M8.6 4.6H14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            <path d="M2 10.4h2.4M6.8 10.4H14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            <path d="M2 13.8h2.4M6.8 13.8H11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                    </span>
                    @(IsAdmin ? "Task Management" : "My Tasks")
                </NavLink>
            </li>
        </ul>

        <ul class="app-nav">
            <li class="app-nav-section">Views</li>
            <li>
                <NavLink class="app-nav-link app-nav-view" href="@($"tasks?status={TaskStatuses.Pending}")"
                         Match="NavLinkMatch.All" @onclick="NotifyNavigated">
                    <span class="view-dot view-pending" aria-hidden="true"></span>
                    Pending
                </NavLink>
            </li>
            <li>
                <NavLink class="app-nav-link app-nav-view" href="@($"tasks?status={TaskStatuses.InProgress}")"
                         Match="NavLinkMatch.All" @onclick="NotifyNavigated">
                    <span class="view-dot view-progress" aria-hidden="true"></span>
                    In progress
                </NavLink>
            </li>
            <li>
                <NavLink class="app-nav-link app-nav-view" href="@($"tasks?status={TaskStatuses.Completed}")"
                         Match="NavLinkMatch.All" @onclick="NotifyNavigated">
                    <span class="view-dot view-done" aria-hidden="true"></span>
                    Completed
                </NavLink>
            </li>
            <li>
                <NavLink class="app-nav-link app-nav-view" href="@($"tasks?priority={TaskPriorities.High}")"
                         Match="NavLinkMatch.All" @onclick="NotifyNavigated">
                    <span class="view-dot view-high" aria-hidden="true"></span>
                    High priority
                </NavLink>
            </li>
        </ul>
    </div>

    <div class="app-sidebar-footer">
        <div class="account">
            <Avatar Name="@UserName" Size="sm" />
            <div class="account-text">
                <div class="account-name">@UserName</div>
                <div class="account-role">@(IsAdmin ? "Administrator" : "Employee")</div>
            </div>
        </div>
    </div>
</nav>

@code {
    /// <summary>Whether the drawer is open on a small screen.</summary>
    [Parameter] public bool IsExpanded { get; set; }

    /// <summary>Raised after a link is followed, so the drawer can close.</summary>
    [Parameter] public EventCallback OnNavigated { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool IsAdmin { get; set; }
    private string? UserName { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var state = await AuthenticationStateTask;
        IsAdmin = state.User.IsInRole(Roles.Admin);
        UserName = state.User.Identity?.Name;
    }

    private Task NotifyNavigated() => OnNavigated.InvokeAsync();
}
