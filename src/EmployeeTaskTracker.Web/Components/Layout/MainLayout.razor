@inherits LayoutComponentBase
@implements IDisposable
@inject TokenStore TokenStore
@inject NavigationManager Navigation

@* The login page renders bare, so the application chrome below only appears
   once somebody is signed in. *@

<AuthorizeView>
    <Authorized>
        <div class="app-shell @(_navExpanded ? "nav-open" : null)">
            <NavMenu IsExpanded="_navExpanded" OnNavigated="CloseNav" />

            @* Tapping the dimmed backdrop closes the drawer on small screens. *@
            <div class="app-backdrop d-lg-none" @onclick="CloseNav"></div>

            <div class="app-main">
                <header class="app-topbar">
                    <button class="btn app-nav-toggle d-lg-none me-3" type="button"
                            @onclick="ToggleNav" aria-label="Toggle navigation" aria-expanded="@_navExpanded">
                        <span class="app-nav-toggle-bar"></span>
                        <span class="app-nav-toggle-bar"></span>
                        <span class="app-nav-toggle-bar"></span>
                    </button>

                    @* Page context rather than the brand, which the sidebar
                       already carries. *@
                    <nav class="crumbs" aria-label="Breadcrumb">
                        <span class="crumb-root">Workspace</span>
                        <span class="crumb-sep" aria-hidden="true">/</span>
                        <span class="crumb-current" aria-current="page">@PageName</span>
                    </nav>

                    <div class="ms-auto d-flex align-items-center gap-3">
                        <div class="text-end d-none d-sm-block">
                            <div class="topbar-name">@context.User.Identity?.Name</div>
                            <div class="eyebrow">@RoleLabel(context)</div>
                        </div>
                        <Avatar Name="@context.User.Identity?.Name" Size="md" />
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SignOutAsync">
                            Sign out
                        </button>
                    </div>
                </header>

                <main class="app-content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _navExpanded;

    protected override void OnInitialized()
        => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // The breadcrumb is derived from the URL, so it has to re-render when
        // the route changes.
        CloseNav();
        StateHasChanged();
    }

    /// <summary>Human-readable name for the current route.</summary>
    private string PageName
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri)
                .Split('?')[0]
                .Trim('/')
                .ToLowerInvariant();

            return path switch
            {
                "" or "dashboard" => "Dashboard",
                "tasks" => "Tasks",
                "not-found" => "Not found",
                _ => "Page"
            };
        }
    }

    private void ToggleNav() => _navExpanded = !_navExpanded;

    private void CloseNav() => _navExpanded = false;

    private async Task SignOutAsync()
    {
        await TokenStore.ClearAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private static string RoleLabel(AuthenticationState state)
        => state.User.IsInRole(Roles.Admin) ? "Administrator" : "Employee";

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
