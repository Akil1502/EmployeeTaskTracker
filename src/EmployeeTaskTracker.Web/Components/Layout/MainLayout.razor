@inherits LayoutComponentBase
@implements IDisposable
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

@* The login page renders bare, so the application chrome below only appears
   once somebody is signed in. *@

<AuthorizeView>
    <Authorized>
        <div class="app-shell @(_navExpanded ? "nav-open" : null)">
            <NavMenu IsExpanded="_navExpanded" OnNavigated="CloseNav" />

            @* Tapping the dimmed backdrop closes the drawer on small screens. *@
            <div class="app-backdrop d-lg-none" @onclick="CloseNav"></div>

            <div class="app-main">
                <header class="app-topbar">
                    @* aria-expanded is spelled out rather than bound to the bool
                       directly: Blazor treats a bool attribute like "disabled"
                       and renders it valueless, which is not a valid value for
                       this attribute and would not match a CSS selector. *@
                    <button class="btn app-nav-toggle d-lg-none me-2" type="button"
                            @onclick="ToggleNav" aria-label="Toggle navigation"
                            aria-expanded="@(_navExpanded ? "true" : "false")">
                        <span class="app-nav-toggle-bar"></span>
                        <span class="app-nav-toggle-bar"></span>
                        <span class="app-nav-toggle-bar"></span>
                    </button>

                    @* Page context rather than the brand, which the sidebar
                       already carries. *@
                    <nav class="crumbs d-none d-md-flex" aria-label="Breadcrumb">
                        <span class="crumb-root">Workspace</span>
                        <span class="crumb-sep" aria-hidden="true">/</span>
                        <span class="crumb-current" aria-current="page">@PageName</span>
                    </nav>

                    @* Jumps to the task list with the term applied, reusing the
                       same query-string filter the sidebar views use. *@
                    <div class="topbar-search">
                        <svg class="topbar-search-icon" width="15" height="15" viewBox="0 0 16 16"
                             fill="none" aria-hidden="true">
                            <circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.5" />
                            <path d="M10.6 10.6L14 14" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" />
                        </svg>
                        <input type="search" class="topbar-search-input"
                               placeholder="Search tasks or people"
                               aria-label="Search tasks by title or assigned employee"
                               value="@_searchTerm"
                               @oninput="e => _searchTerm = e.Value?.ToString()"
                               @onkeydown="OnSearchKeyDown" />
                        <kbd class="topbar-search-hint d-none d-xl-inline">Enter</kbd>
                    </div>

                    <div class="topbar-actions">
                        <div class="account-menu">
                            <button class="account-trigger" type="button" @onclick="ToggleAccountMenu"
                                    aria-haspopup="true"
                                    aria-expanded="@(_accountMenuOpen ? "true" : "false")">
                                <Avatar Name="@context.User.Identity?.Name" Size="md" />
                                <span class="account-trigger-text d-none d-lg-block">
                                    <span class="topbar-name">@context.User.Identity?.Name</span>
                                    <span class="eyebrow d-block">@RoleLabel(context)</span>
                                </span>
                                <svg class="account-chevron d-none d-lg-block" width="10" height="10"
                                     viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>

                            @if (_accountMenuOpen)
                            {
                                <div class="account-sheet-backdrop" @onclick="CloseAccountMenu"></div>
                                <div class="account-sheet">
                                    <div class="account-sheet-head">
                                        <Avatar Name="@context.User.Identity?.Name" Size="lg" />
                                        <div class="account-sheet-id">
                                            <div class="account-sheet-name">@context.User.Identity?.Name</div>
                                            <div class="account-sheet-mail">@EmailOf(context)</div>
                                        </div>
                                    </div>
                                    <div class="account-sheet-role">
                                        <span class="pill @(context.User.IsInRole(Roles.Admin) ? "pill-done" : "pill-neutral")">
                                            @RoleLabel(context)
                                        </span>
                                    </div>
                                    <button class="account-sheet-action" type="button" @onclick="SignOutAsync">
                                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                            <path d="M6 14H3.2A1.2 1.2 0 0 1 2 12.8V3.2A1.2 1.2 0 0 1 3.2 2H6"
                                                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                            <path d="M10.5 11L14 8l-3.5-3M14 8H6" stroke="currentColor"
                                                  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        Sign out
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </header>

                <main class="app-content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _navExpanded;
    private bool _accountMenuOpen;
    private string? _searchTerm;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        SyncSearchFromUrl();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // The breadcrumb is derived from the URL, so it has to re-render when
        // the route changes. Any open overlay is dismissed at the same time.
        CloseNav();
        _accountMenuOpen = false;
        SyncSearchFromUrl();
        StateHasChanged();
    }

    /// <summary>
    /// Signing out does not tear down the Blazor circuit, so this layout - and
    /// every field on it - outlives the session. Clearing the box here stops one
    /// person's search term being visible to whoever signs in next.
    /// </summary>
    private void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        _searchTerm = null;
        _accountMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Keeps the box showing whatever the current URL is filtered by, so it
    /// reflects the visible results rather than holding state of its own.
    /// </summary>
    private void SyncSearchFromUrl()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        _searchTerm = query.TryGetValue("search", out var value)
            ? value.ToString()
            : null;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
            return;

        var term = _searchTerm?.Trim();

        Navigation.NavigateTo(string.IsNullOrEmpty(term)
            ? "/tasks"
            : $"/tasks?search={Uri.EscapeDataString(term)}");

        await Task.CompletedTask;
    }

    /// <summary>Human-readable name for the current route.</summary>
    private string PageName
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri)
                .Split('?')[0]
                .Trim('/')
                .ToLowerInvariant();

            return path switch
            {
                "" or "dashboard" => "Dashboard",
                "tasks" => "Tasks",
                "not-found" => "Not found",
                _ => "Page"
            };
        }
    }

    private void ToggleNav() => _navExpanded = !_navExpanded;

    private void CloseNav() => _navExpanded = false;

    private void ToggleAccountMenu() => _accountMenuOpen = !_accountMenuOpen;

    private void CloseAccountMenu() => _accountMenuOpen = false;

    private async Task SignOutAsync()
    {
        _accountMenuOpen = false;
        _searchTerm = null;

        await TokenStore.ClearAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private static string RoleLabel(AuthenticationState state)
        => state.User.IsInRole(Roles.Admin) ? "Administrator" : "Employee";

    private static string EmailOf(AuthenticationState state)
        => state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
