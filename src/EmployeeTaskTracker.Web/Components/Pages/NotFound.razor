@page "/not-found"

@* Reached two ways:
   - A URL that matches no endpoint at all. ASP.NET returns 404 before the
     Blazor Router runs, so Program.cs re-executes the request into this page.
   - A client-side navigation inside the circuit that matches no route, which
     the Router's <NotFound> fragment sends here. *@

<PageTitle>Page not found - Employee Task Tracker</PageTitle>

<div class="container py-5 text-center">
    <div class="display-1 text-muted">404</div>
    <h1 class="h3 mb-3">Page not found</h1>
    <p class="text-muted mb-4">Sorry, there is nothing at this address.</p>
    <a class="btn btn-primary" href="/dashboard">Back to dashboard</a>
</div>
